PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/college_mis
# Exact frontend URL for CORS, for example https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma-separated (useful for Vercel preview URLs)
FRONTEND_URLS=
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# For Render + Vercel, use COOKIE_SECURE=true and COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=College MIS <noreply@example.com>
